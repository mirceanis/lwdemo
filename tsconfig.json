{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "types": ["node"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,

    "rootDir": "src",
    "outDir": "dist",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.mts", "src/**/*.cts"]
}
